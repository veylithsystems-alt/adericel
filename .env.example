# Adericel configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is the documented
# surface. Every variable Adericel reads is listed, with its default, so nothing
# is configurable only by reading the source.
#
# Generate the three secrets below before first start:
#
#   openssl rand -base64 48   # AUTH_JWT_SECRET
#   openssl rand -base64 32   # AUTH_CREDENTIAL_ENCRYPTION_KEY
#   openssl rand -hex 32      # N8N_ENCRYPTION_KEY
#
# AUTH_CREDENTIAL_ENCRYPTION_KEY encrypts stored integration credentials. If you
# lose it, those credentials are unrecoverable and must be re-entered — which is
# the point. Back it up somewhere other than the machine it protects.

# ------------------------------------------------------------------ deployment
ADERICEL_DOMAIN=adericel.example.com
N8N_DOMAIN=workflows.example.com
ACME_EMAIL=ops@example.com
TZ=Europe/London
ADERICEL_RELEASE_VERSION=0.1.0
LOG_LEVEL=info

# -------------------------------------------------------------------- database
POSTGRES_USER=adericel
POSTGRES_PASSWORD=
POSTGRES_DB=adericel
# Used directly when running outside compose.
DATABASE_URL=postgres://adericel:password@localhost:5432/adericel
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
# The role every transaction assumes, via SET LOCAL ROLE, so that row level
# security is evaluated against a role that provably cannot bypass it.
#
# Created by migration 0011. This is not cosmetic: a superuser bypasses RLS
# unconditionally and FORCE ROW LEVEL SECURITY does nothing about it, so without
# this the second layer of tenant isolation depends entirely on how you
# provisioned the role in DATABASE_URL. The API and worker verify the property
# at startup and refuse to run in production if it does not hold.
DATABASE_APPLICATION_ROLE=adericel_app
DATABASE_SSL=false

# ------------------------------------------------------------------------- API
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=https://adericel.example.com
# Comma-separated. The interface is same-origin, so in a normal deployment this
# is just the public URL. Never set it to "*".
API_CORS_ORIGINS=https://adericel.example.com
API_BODY_LIMIT_BYTES=2097152
API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_WINDOW_MS=60000
# Only true when something you control terminates TLS in front of the API. Left
# true with the API directly exposed, a client can forge its own source address.
API_TRUST_PROXY=true

# ---------------------------------------------------------------------- secrets
# No defaults in production — the API refuses to start without these rather than
# booting with a known key.
AUTH_JWT_SECRET=
AUTH_CREDENTIAL_ENCRYPTION_KEY=
# Optional. Mixed into password hashing; stored outside the database so a
# database-only disclosure does not permit offline cracking. Changing it
# invalidates every existing password.
AUTH_PASSWORD_PEPPER=
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
AUTH_ISSUER=adericel
AUTH_AUDIENCE=adericel-api

# ------------------------------------------------------------------- storage
# filesystem for a single node, s3 for anything you intend to back up properly.
STORAGE_DRIVER=s3
STORAGE_FILESYSTEM_ROOT=./storage/local
STORAGE_S3_BUCKET=adericel-evidence
STORAGE_S3_REGION=eu-west-2
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# MinIO and most non-AWS S3 implementations require path-style addressing.
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_MAX_UPLOAD_BYTES=52428800
MINIO_ROOT_USER=adericel
MINIO_ROOT_PASSWORD=

# -------------------------------------------------------------------- worker
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=25
WORKER_MAX_DELIVERY_ATTEMPTS=8
WORKER_VISIBILITY_TIMEOUT_MS=60000

# ----------------------------------------------------------------------- n8n
# Adericel runs without n8n. Setting this to true only tells the API that an
# orchestrator exists and that inbound webhooks should be accepted from it.
N8N_ENABLED=false
N8N_BASE_URL=http://n8n:5678
# HMAC secret for inbound webhooks. Left empty, webhook ingestion is disabled
# outright rather than accepting unsigned deliveries. Minimum 32 characters when
# N8N_ENABLED is true.
N8N_WEBHOOK_SIGNING_SECRET=
N8N_ENCRYPTION_KEY=
N8N_DB_NAME=n8n

# Read by the imported workflows themselves.
ADERICEL_API_BASE_URL=http://api:4000
ADERICEL_MSP_ID=
ADERICEL_NOTIFY_EMAIL=
ADERICEL_NOTIFY_FROM=
ADERICEL_NOTIFY_WEBHOOK_URL=

# ----------------------------------------------------------------- inference
# Local first. This is the principle, not a tier.
#
# Adericel reads penetration test reports, supplier certificates and insurance
# questionnaires — among the most sensitive documents an organisation owns. The
# ordinary path for reading them runs on hardware you control.
#
#   none               No model. THE DEFAULT, and a complete deployment: a model
#                      may only ever propose a candidate claim a person confirms,
#                      so no assurance determination depends on one existing.
#   ollama             A model on your own hardware. Start it with the `ai`
#                      compose profile and pull the model on the host.
#   openai-compatible  vLLM, llama.cpp, LM Studio or a hosted vendor. Classified
#                      EXTERNAL whoever runs it — the protocol does not say — and
#                      start-up refuses without a written acknowledgement below.
INFERENCE_PROVIDER=none
INFERENCE_BASE_URL=http://ollama:11434
INFERENCE_MODEL=llama3.1:8b
# Empty for Ollama, which has no notion of a key.
INFERENCE_API_KEY=
# Generous on purpose: CPU inference reading a certificate is not quick, and a
# ten-second timeout reports a misconfiguration as a model failure.
INFERENCE_REQUEST_TIMEOUT_MS=120000
INFERENCE_MAX_OUTPUT_TOKENS=2048
# Required before any data may leave infrastructure you control. Name the
# operator and the jurisdiction. Recorded verbatim and reported at
# /v1/system/data-processing, so the decision has an author.
#   e.g. "Processed by Contoso Cloud Ltd in the United Kingdom under DPA 2024-11,
#         approved by M. Rowe."
INFERENCE_EXTERNAL_ACKNOWLEDGEMENT=
# Gates the document-extraction branch of the n8n workflow. Off by default;
# extraction refuses cleanly rather than proposing nothing silently.
ADERICEL_AI_EXTRACTION_ENABLED=false
# Cores Ollama may use when the `ai` profile is running. Leave headroom or
# inference will starve PostgreSQL and health checks begin to time out.
OLLAMA_CPUS=3

# ------------------------------------------------------------------ security
# Hosts integrations may reach. Empty means no restriction, which is acceptable
# in development and is not acceptable in production.
SECURITY_EGRESS_ALLOWLIST=
# Blocks integration requests to private, loopback, link-local and carrier-grade
# NAT ranges after DNS resolution. This is the SSRF control; leave it on.
SECURITY_BLOCK_PRIVATE_EGRESS=true
SECURITY_ALLOWED_EVIDENCE_MIME_TYPES=

# ------------------------------------------------------------------- billing
# A planning default, not a hard-coded price. Per-MSP pricing overrides it, and
# nothing in the assurance model depends on any of these values.
BILLING_DEFAULT_ORG_PRICE_MINOR=19900
BILLING_CURRENCY=GBP
BILLING_TRIAL_DAYS=30

# ------------------------------------------------- passport signing (interchange)
# The key that signs Assurance Passports so a recipient can verify them offline,
# with no Adericel account and no network call.
#
# This is a SEPARATELY ESTABLISHED credential. It is not derived from
# AUTH_JWT_SECRET or AUTH_CREDENTIAL_ENCRYPTION_KEY and must never be: rotating
# an application secret would otherwise invalidate every signature ever issued,
# and disclosing one would disclose the other.
#
# Generate with:  pnpm passport:keygen adericel-prod-2026-01 "Your Company Ltd"
#
# Off by default. A deployment with no key exports Passports with a content hash
# and says plainly that they are unsigned — it does not call a hash a signature.
# Start-up refuses if signing is on and no key is present.
PASSPORT_SIGNING_ENABLED=false
# The private half, as one JSON document. Put it in a secret store, not here.
# {"keyId":"...","algorithm":"Ed25519","issuer":"...","privateKey":"..."}
PASSPORT_SIGNING_KEY=
# The public halves, as a JSON array — every key ever used, including retired
# ones. RETIRED keys are never removed: a Passport signed by a key that has been
# dropped fails verification in a way that looks like tampering. A key believed
# compromised gets status REVOKED, which is a different and deliberate answer.
PASSPORT_KEYRING=
# Serves the issuer public keys and verifies a submitted envelope. Neither reads
# a tenant row or accepts an identifier, so it cannot be used to discover who
# your customers are. Leave it on: a signature nobody can check is decoration.
PASSPORT_PUBLIC_VERIFICATION_ENABLED=true

# ------------------------------------------------------------- development only
# Both are guards, not switches: they only take effect when set to the literal
# string "yes". `db:reset` additionally refuses to run at all when NODE_ENV is
# production, whatever this is set to.
ADERICEL_ALLOW_DEMO_SEED=no
ADERICEL_ALLOW_RESET=no
SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Outbound notification
#
# Signup verification and invitations go through this. `log` writes messages to
# the application log and is for development only — production start-up refuses
# it, because a deployment that accepts signups and loses their verification
# links has not onboarded anybody.
#
# `http-email` posts to a transactional email provider's API. The default body
# mapping follows Postmark's field names; point NOTIFY_HTTP_ENDPOINT at another
# provider only if its request shape matches.
# ---------------------------------------------------------------------------
NOTIFY_DRIVER=log
NOTIFY_FROM_ADDRESS=no-reply@adericel.invalid
NOTIFY_FROM_NAME=Adericel
NOTIFY_HTTP_ENDPOINT=
NOTIFY_HTTP_AUTH_HEADER=X-Postmark-Server-Token
NOTIFY_HTTP_AUTH_TOKEN=

# --------------------------------------------------------------------- backup
# Where dumps and their manifests are written. Back this directory up OFF the
# host: a backup on the same VPS does not survive losing the VPS.
#
# Take one with:
#   docker compose --profile core --profile backup run --rm backup
#
# And prove it — a backup that has never been restored is not proven:
#   infrastructure/docker/backup/restore.sh <dump> adericel_restore_check
#   pnpm verify:restore --target adericel_restore_check --manifest <manifest>
BACKUP_DIR=./var/backup
BACKUP_RETAIN_DAYS=14

# -------------------------------------------------------------------- billing
# `manual` is a real answer, not a placeholder: a deployment that invoices by
# bank transfer needs no provider, and the checkout routes refuse rather than
# pretending. With `stripe`, production start-up requires both secrets —
# without a webhook secret the endpoint would accept unsigned billing events,
# which is a way for anyone who finds it to activate their own subscription.
BILLING_PROVIDER=manual
BILLING_STRIPE_SECRET_KEY=
BILLING_STRIPE_WEBHOOK_SECRET=
BILLING_STRIPE_API_BASE_URL=https://api.stripe.com
