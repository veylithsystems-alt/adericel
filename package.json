{
  "name": "adericel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adericel \u2014 Autonomous Organisational Security Assurance Infrastructure",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:web": "pnpm --filter @adericel/web build",
    "clean": "tsc -b --clean tsconfig.build.json && rm -rf apps/*/dist packages/*/dist apps/web/dist",
    "typecheck": "tsc -b tsconfig.build.json && pnpm --filter @adericel/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit packages",
    "test:integration": "vitest run tests/integration",
    "test:tenancy": "vitest run tests/tenancy",
    "test:security": "vitest run tests/security",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:status": "tsx scripts/migrate.ts status",
    "db:reset": "tsx scripts/migrate.ts reset",
    "db:seed": "tsx scripts/seed-demo.ts",
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx --conditions=development watch apps/api/src/main.ts",
    "dev:worker": "tsx --conditions=development watch apps/worker/src/main.ts",
    "dev:web": "pnpm --filter @adericel/web dev",
    "start:api": "node apps/api/dist/main.js",
    "start:worker": "node apps/worker/dist/main.js",
    "openapi:emit": "tsx --conditions=development scripts/emit-openapi.ts",
    "n8n:build": "tsx --conditions=development workflows/n8n/build.ts",
    "n8n:validate": "tsx --conditions=development workflows/n8n/validate.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.37.0",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
