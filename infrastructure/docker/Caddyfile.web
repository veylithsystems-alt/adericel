# Static file server for the built interface, behind the edge proxy.
#
# No TLS here and no automatic HTTPS: this listens on the compose network only,
# and `caddy` in front of it terminates TLS. Running ACME in two places would
# mean two certificates for one hostname.
{
	auto_https off
	admin off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Hashed assets are immutable; anything else must be revalidated so a deploy
	# is visible on the next load rather than whenever a browser feels like it.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header Cache-Control "no-cache"

	# Client-side routing: unknown paths are application routes, not 404s. The
	# API is not reachable through this server, so there is no route here that
	# could shadow one.
	try_files {path} /index.html
	file_server
}
