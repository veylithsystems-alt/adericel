# Adericel web interface.
#
# The result is static files. There is no server-side rendering and no Node
# process in the running container: the interface talks to the API over HTTP
# like any other client, which keeps the browser's authority exactly equal to
# the token it holds and nothing more.
#
# Build from the repository root:
#   docker build -f infrastructure/docker/Dockerfile.web -t adericel/web .

FROM node:22.22-alpine AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/shared/package.json        packages/shared/
COPY packages/domain/package.json        packages/domain/
COPY packages/graph/package.json         packages/graph/
COPY packages/evidence/package.json      packages/evidence/
COPY packages/truth-engine/package.json  packages/truth-engine/
COPY packages/policy/package.json        packages/policy/
COPY packages/actions/package.json       packages/actions/
COPY packages/integrations/package.json  packages/integrations/
COPY apps/api/package.json               apps/api/
COPY apps/worker/package.json            apps/worker/
COPY apps/web/package.json               apps/web/

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

COPY tsconfig.base.json tsconfig.build.json tsconfig.json ./
COPY packages/ packages/
COPY apps/ apps/

# The interface imports the domain vocabulary — assurance states, unknown
# reasons — from @adericel/domain rather than restating it, so the packages have
# to be built before Vite can resolve them.
RUN pnpm build

# The bundle carries no API hostname. Every request goes to /api on whatever
# origin served the page, so the edge proxy decides where the API is and the
# same image runs unchanged in every environment. It also means the browser
# never holds a cross-origin token.
RUN pnpm build:web

# ------------------------------------------------------------------- runtime
FROM caddy:2-alpine AS runtime

COPY --from=build /app/apps/web/dist /srv
COPY infrastructure/docker/Caddyfile.web /etc/caddy/Caddyfile

EXPOSE 8080
